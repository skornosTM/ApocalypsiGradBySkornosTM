{
  "delayModifier": {
    // Modifies the delay between songs, lower = shorter delay (1.0 = vanilla). 
    // Default = 0.25
    "delayModifier": 0.35
  },

  "pitchVariance": {
    // Adds randomized pitch variance of up to the given value (e.g. 0.1), makes songs sound slightly different.
    // Default = 0
    "pitchVariance": 0.0
  },

  "musicVariance": {
    // Enables more varied music to be available for biomes, 
    // Default = true
    "musicVariance": true
  },

  "smartMusic": {
    // Enables smart stopping of music, when the biome changes or player leaves a cave/water/night is over, 
    // Default = true
    "smartMusic": true
  },

  "disableDefaultMusicInDimensions": {
    // Disables overworld music being played at random(rarely) in nether/end, 
    // Default = true
    "disableDefaultMusicInDimensions": true
  },

  "displayMusicPlayed": {
    // Shows currently played music in chat/log, 
    // Default = false
    "displayMusicPlayed": false
  },

  "playonlycustomnightmusic": {
    // Plays only custom provided music at night, 
    // Default = false
    "playonlycustomnightmusic": false
  },

  "logloadedmusic": {
    // Prints the music files getting loaded into the latest.log, 
    // Default = false
    "logloadedmusic": false
  }
}
