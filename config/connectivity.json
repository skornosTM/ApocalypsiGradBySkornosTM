{
  "disableLoginLimits": {
    // Should login packet size limits be disabled? Error:(IOException("Payload may not be larger than 1048576 bytes")) 
    // Default:true
    "disableLoginLimits": true
  },

  "disablePacketLimits": {
    // Should play packet size limits be disabled? Error:(Badly compressed packet) 
    // Default:true
    "disablePacketLimits": true
  },

  "disableChatVerificationDisconnect": {
    // (Clientside) Disables players disconnecting on chat message verification problems,(enable debugPrintMessages to see the message causing issues).
    // Default:true
    "disableChatVerificationDisconnect": true
  },

  "debugPrintMessages": {
    // Enable addition debug logging for networking errors. 
    // Default:false
    "debugPrintMessages": false
  },

  "logintimeout": {
    // Set the max login timeout in seconds. 
    // Default = 120
    "logintimeout": 120
  },

  "disconnectTimeout": {
    // Set the ingame disconnect timeout for disconnecting players. 
    // Default = 60sec
    "disconnectTimeout": 60
  },

  "packetHistoryMinutes": {
    // Set the amount of minutes for which network packet history data is saved. 
    // Default = 5 minutes
    "packetHistoryMinutes": 5
  },

  "showFullResourceLocationException": {
    // Enable to see the full log output for all resource location exceptions. 
    // Default = false
    "showFullResourceLocationException": false
  }
}
